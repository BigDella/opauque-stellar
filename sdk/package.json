{
  "name": "@opaquecash/stellar",
  "version": "0.2.0",
  "description": "Stealth private payments, privacy pools, relayer-market submission, and on-chain ZK reputation for Stellar/Soroban.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "stellar",
    "soroban",
    "zk",
    "zero-knowledge",
    "groth16",
    "privacy",
    "stealth-addresses",
    "privacy-pool",
    "reputation"
  ],
  "homepage": "https://github.com/collinsadi/opaque-stellar/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collinsadi/opaque-stellar.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/collinsadi/opaque-stellar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto/index.d.ts",
        "default": "./dist/crypto/index.js"
      },
      "require": {
        "types": "./dist/crypto/index.d.cts",
        "default": "./dist/crypto/index.cjs"
      }
    },
    "./relayer-protocol": {
      "import": {
        "types": "./dist/relayer-protocol/index.d.ts",
        "default": "./dist/relayer-protocol/index.js"
      },
      "require": {
        "types": "./dist/relayer-protocol/index.d.cts",
        "default": "./dist/relayer-protocol/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && npm run check:size",
    "check:examples": "npm install --prefix examples/react-quickstart && npm run build --prefix examples/react-quickstart",
    "check:size": "node scripts/check-bundle-size.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:docs": "node scripts/check-doc-snippets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src tests",
    "check:exports": "publint --strict && attw --pack . --profile node16",
    "smoke:install": "node scripts/clean-room-install.mjs",
    "benchmark:scan": "tsx scripts/benchmark-scan-report.ts",
    "benchmark:scan:ts": "tsx scripts/benchmark-scan.ts",
    "benchmark:scan:wasm": "tsx scripts/benchmark-scan-wasm.ts",
    "benchmark:scan:gate": "tsx scripts/benchmark-scan-regression-gate.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "docs:api": "typedoc",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run check:examples"
  },
  "peerDependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "circomlibjs": "^0.1.7",
    "snarkjs": "^0.7.6",
    "tweetnacl": "^1.0.3"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    },
    "circomlibjs": {
      "optional": true
    },
    "tweetnacl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@stellar/stellar-sdk": "^15.1.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "circomlibjs": "^0.1.7",
    "eslint": "^9.39.4",
    "fast-check": "^3.17.1",
    "publint": "^0.3.21",
    "snarkjs": "^0.7.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.4",
    "tweetnacl": "^1.0.3",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
