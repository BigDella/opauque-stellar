#!/usr/bin/env bash
# opaque-verify-backup: automated restore verification for opaque-backup output.
# Documented in docs/state-backups.md. Install to /usr/local/bin/opaque-verify-backup.
#
# For each service, decrypts the newest backup, fully extracts it into a temp
# directory, and requires the result to be non-empty. Exits 1 on any failure.
#
# Environment: OPAQUE_BACKUP_DIR, OPAQUE_BACKUP_PASSPHRASE_FILE (as opaque-backup),
# OPAQUE_BACKUP_MAX_AGE_DAYS (default: 1).
set -euo pipefail
umask 077

BACKUP_ROOT="${OPAQUE_BACKUP_DIR:-/var/backups/opaque}"
PASSPHRASE_FILE="${OPAQUE_BACKUP_PASSPHRASE_FILE:-/etc/opaque/backup-passphrase}"
RESTORE_TMP=$(mktemp -d)
trap 'rm -rf "$RESTORE_TMP"' EXIT

MAX_AGE_DAYS="${OPAQUE_BACKUP_MAX_AGE_DAYS:-1}"
if ! [[ "$MAX_AGE_DAYS" =~ ^[0-9]+$ ]]; then
  echo "FAIL: OPAQUE_BACKUP_MAX_AGE_DAYS must be a non-negative integer" >&2
  exit 2
fi
services=(asp publisher relayer)

FAILURES=0
for service in "${services[@]}"; do
  # Timestamps are UTC and sortable, so name order is chronological order.
  latest=$(ls "$BACKUP_ROOT/${service}"-*.tar.gz.gpg 2>/dev/null | sort | tail -1 || true)
  if [[ -z "$latest" ]]; then
    echo "FAIL: no backup found for $service"
    FAILURES=$((FAILURES + 1))
    continue
  fi

  # `find -mmin` is intentionally used instead of parsing timestamps: it also
  # detects archives copied into the backup directory with stale metadata.
  if find "$latest" -mmin "+$((MAX_AGE_DAYS * 24 * 60))" -print -quit | grep -q .; then
    echo "FAIL: $service - newest backup is older than ${MAX_AGE_DAYS} day(s): $(basename "$latest")"
    FAILURES=$((FAILURES + 1))
    continue
  fi

  dest="$RESTORE_TMP/$service"
  mkdir -p "$dest"
  if gpg --batch --pinentry-mode loopback --passphrase-file "$PASSPHRASE_FILE" \
         --decrypt "$latest" 2>/dev/null \
       | tar -xzf - -C "$dest" 2>/dev/null \
     && [[ -n "$(ls -A "$dest")" ]]; then
    echo "OK: $service - $(basename "$latest") restores cleanly"
  else
    echo "FAIL: $service - $(basename "$latest") failed restore verification"
    FAILURES=$((FAILURES + 1))
  fi
done

if [[ $FAILURES -gt 0 ]]; then
  echo "Backup verification: $FAILURES failure(s)" >&2
  exit 1
fi
echo "Backup verification: all services OK"
